{
  "$schema": "animexplore-design-system/v1",
  "design_system": {
    "name": "AnimeXplore Cinematic Dark UI",
    "version": "1.0",
    "description": "Design specification for AnimeXplore — dark cinematic anime streaming UI. Values mirror css/style.css and index.html. Loaded at runtime by js/design.js.",
    "source_project": "AnimeXplore / animexploree",

    "user_notes": {
      "recommended_browser": {
        "name": "Brave Browser",
        "url": "https://brave.com/",
        "reasons": [
          "Faster page loads with built-in ad and tracker blocking",
          "Smoother handling of third-party streaming embed redirects",
          "Better performance for iframe-based MegaPlay players"
        ],
        "ui_placement": ["footer.footer-browser-tip", "README.md Recommended browser section"]
      }
    },

    "style": {
      "theme": "cinematic_dark",
      "theme_color": "#050505",
      "design_principles": [
        "Deep black cinematic base (#050505) with gold accent highlights",
        "Glass panels with frosted blur on cards, player, and sidebar",
        "Blue-to-gold brand gradient for active states and CTAs",
        "Hero spotlight with full-bleed backdrop and left vignette overlay",
        "Gold section titles and nav active states for browse hierarchy",
        "Sticky flat header bar — not floating pill nav",
        "Content-first layout: home hero → trending → series watch zone",
        "Motion pauses during streaming via html.perf-streaming",
        "ShapeGrid background disabled (display:none) in production theme"
      ],

      "css_custom_properties": {
        "_comment": "Map 1:1 to :root in css/style.css. applyAnimeXploreTheme() in js/design.js overrides highlight/gold tokens at runtime.",
        "--bg": "#050505",
        "--surface": "rgba(255, 255, 255, 0.08)",
        "--surface-2": "rgba(255, 255, 255, 0.04)",
        "--glass-border": "rgba(30, 58, 95, 0.55)",
        "--glass-border-2": "rgba(30, 58, 95, 0.35)",
        "--highlight": "#38bdf8",
        "--highlight-soft": "#60a5fa",
        "--accent-purple": "#06b6d4",
        "--accent-blue": "#3b82f6",
        "--text-1": "#ffffff",
        "--text-2": "rgba(255, 255, 255, 0.65)",
        "--text-3": "rgba(255, 255, 255, 0.35)",
        "--shadow-soft": "0 8px 32px rgba(0, 0, 0, 0.5)",
        "--shadow-glass": "inset 0 0 0 1px rgba(255, 255, 255, 0.08)",
        "--blur": "blur(20px)",
        "--player-bg": "#050507",
        "--success": "#10b981",
        "--warning": "#f59e0b",
        "--r-sm": "8px",
        "--r-md": "16px",
        "--r-lg": "24px",
        "--r-pill": "999px",
        "--font": "'Inter', 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif",
        "--sidebar-w": "300px",
        "--header-h": "72px",
        "--ease": "cubic-bezier(0.4, 0, 0.2, 1)",
        "--ease-smooth": "cubic-bezier(0.22, 1, 0.36, 1)",
        "--dur-fast": "0.2s",
        "--dur-med": "0.35s",
        "--dur-slow": "0.5s",
        "--grad-brand": "linear-gradient(135deg, #3b82f6, #06b6d4)",
        "--accent-dim": "rgba(59, 130, 246, 0.12)",
        "--accent-glow": "rgba(59, 130, 246, 0.35)",
        "--gold": "#e8c547",
        "--gold-bright": "#f5d87a",
        "--gold-dim": "rgba(232, 197, 71, 0.15)"
      },

      "runtime_theme_overrides": {
        "_comment": "Applied by applyAnimeXploreTheme() after Design.json load",
        "--highlight": "#d4a853",
        "--highlight-soft": "#e8c547",
        "--grad-brand": "linear-gradient(135deg, #3b82f6, #d4a853)",
        "--gold": "#d4a853",
        "--gold-bright": "#e8c547",
        "--gold-dim": "rgba(212, 168, 83, 0.12)",
        "--glass-border": "rgba(255, 255, 255, 0.08)",
        "--glass-border-2": "rgba(255, 255, 255, 0.05)"
      },

      "color_palette": {
        "primary_bg": "#050505",
        "secondary_bg": "rgba(255, 255, 255, 0.04)",
        "glass_surface": "rgba(255, 255, 255, 0.08)",
        "glass_border": "rgba(30, 58, 95, 0.55)",
        "glass_border_light": "rgba(30, 58, 95, 0.35)",
        "highlight": "#38bdf8",
        "highlight_soft": "#60a5fa",
        "accent_cyan": "#06b6d4",
        "accent_blue": "#3b82f6",
        "gold": "#e8c547",
        "gold_bright": "#f5d87a",
        "gold_dim": "rgba(232, 197, 71, 0.15)",
        "text_primary": "#ffffff",
        "text_secondary": "rgba(255, 255, 255, 0.65)",
        "text_tertiary": "rgba(255, 255, 255, 0.35)",
        "player_bg": "#050507",
        "success": "#10b981",
        "warning": "#f59e0b"
      },

      "gradients": {
        "brand_primary": {
          "css": "linear-gradient(135deg, #3b82f6, #06b6d4)",
          "css_runtime": "linear-gradient(135deg, #3b82f6, #d4a853)",
          "usage": ["tool-btn.active", "server-btn.active", "ep-row.active", "rating-score text"]
        },
        "brand_name": {
          "css": "linear-gradient(90deg, #ffffff 0%, #7ec8ff 45%, #e8c547 100%)",
          "usage": [".brand-name", ".footer-brand-text"]
        },
        "hero_overlay": {
          "css": "multi-layer linear gradients left vignette + bottom fade + top shade",
          "usage": [".hero-overlay"]
        },
        "server_panel": {
          "css": "linear-gradient(135deg, rgba(59, 130, 246, 0.08), rgba(6, 182, 212, 0.05))",
          "usage": [".server-panel"]
        }
      },

      "typography": {
        "font_family": "Inter, SF Pro Display, -apple-system, BlinkMacSystemFont, sans-serif",
        "google_fonts_url": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap",
        "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
        "antialiasing": "-webkit-font-smoothing: antialiased",
        "line_height_body": 1.6,
        "scale": {
          "brand_name": "24px weight 800",
          "hero_title": "clamp(28px, 4vw, 44px)",
          "section_title_gold": "22px weight 800",
          "series_title": "clamp(20px, 3vw, 28px)",
          "body": "14px",
          "small": "13px",
          "caption": "12px",
          "micro": "11px",
          "section_label": "11px"
        },
        "text_styles": {
          "section_label": {
            "class": ".s-label",
            "font_size": "11px",
            "font_weight": 700,
            "letter_spacing": "1.4px",
            "text_transform": "uppercase",
            "color": "var(--highlight)",
            "opacity": 0.85
          },
          "section_title_gold": {
            "class": ".section-title-gold",
            "font_size": "22px",
            "font_weight": 800,
            "color": "var(--gold)"
          },
          "brand_name": {
            "class": ".brand-name",
            "font_weight": 800,
            "letter_spacing": "-0.02em",
            "technique": "gradient text clip white → blue → gold"
          }
        }
      },

      "spacing": {
        "unit": 8,
        "header_height": "72px",
        "sidebar_width": "300px",
        "page_max_width": "1400px",
        "page_padding": "20px 24px 40px",
        "home_section_padding": "28px 48px 8px",
        "hero_inner_padding": "48px 48px 56px",
        "footer_padding": "48px 32px 36px desktop / 32px 16px mobile"
      },

      "radius": {
        "small": "8px",
        "medium": "16px",
        "large": "24px",
        "pill": "999px"
      },

      "shadows": {
        "soft": "0 8px 32px rgba(0, 0, 0, 0.5)",
        "glass_inset": "inset 0 0 0 1px rgba(255, 255, 255, 0.08)",
        "header": "0 4px 24px rgba(0, 0, 0, 0.45)",
        "brand_icon": "drop-shadow(0 2px 10px rgba(59, 130, 246, 0.35))",
        "btn_watch_hover": "0 8px 24px rgba(232, 197, 71, 0.35)",
        "trending_card_hover": "0 12px 32px rgba(0, 0, 0, 0.45)"
      },

      "z_index_layers": {
        "main_content": 2,
        "search_dropdown": 200,
        "proxy_banner": 3,
        "site_header": 9000,
        "mobile_bottom_nav": 8500,
        "devtools_block": 999999
      }
    },

    "layout": {
      "type": "spa_multi_view",
      "views": ["homeView", "seriesView"],
      "scroll_behavior": "smooth",
      "section_order_home": [
        "site-header (sticky)",
        "hero-spotlight (#heroSection)",
        "continue-section (#continueSection, optional)",
        "home-trending (#homeTrendingSection)",
        "category-section (#categorySection, browse mode)",
        "site-footer",
        "mobile-bottom-nav"
      ],
      "section_order_series": [
        "site-header",
        "page.series-mode (flex: content + sidebar-related)",
        "watch-zone → episodes-panel → detail-panel",
        "sidebar-related",
        "site-footer",
        "mobile-bottom-nav"
      ],
      "page_modes": {
        "home-mode": "full width, sidebar hidden",
        "series-mode": "max-width 1400px, sidebar visible"
      },
      "breakpoints": {
        "mobile": "max-width: 768px",
        "tablet": "769px – 1024px",
        "desktop": "min-width: 1025px"
      }
    },

    "background": {
      "shapegrid": {
        "container_id": "sg-global-bg",
        "enabled": false,
        "note": "Hidden via #sg-global-bg { display: none !important; } — cinematic flat black theme"
      },
      "body": {
        "background": "var(--bg) #050505",
        "overflow_x": "hidden"
      }
    },

    "components": {
      "proxy_banner": {
        "id": "proxyBanner",
        "class": "proxy-banner",
        "message": "API unavailable — run npm start locally or deploy to Vercel.",
        "style": {
          "background": "var(--accent-dim)",
          "border_bottom": "1px solid var(--accent-glow)",
          "color": "var(--highlight-soft)"
        }
      },

      "site_header": {
        "class": "site-header",
        "position": "sticky top 0",
        "height": "var(--header-h) 72px",
        "padding": "14px 32px",
        "background": "rgba(5, 5, 5, 0.94)",
        "border_bottom": "1px solid rgba(255, 255, 255, 0.06)",
        "children": {
          "brand": {
            "class": "brand",
            "icon": "favicon.png 40×40",
            "text_class": "brand-name",
            "text": "AnimeXplore"
          },
          "search": {
            "wrap": "search-wrap",
            "input_id": "searchInput",
            "dropdown_id": "searchDropdown",
            "placeholder": "Search anime...",
            "style": "pill input, focus ring accent-dim"
          },
          "nav": {
            "class": "header-nav",
            "items": ["Home", "Movies", "TV Series", "Most Popular", "Top Airing"],
            "active_state": "color gold-bright, background gold-dim"
          }
        }
      },

      "hero_spotlight": {
        "id": "heroSection",
        "class": "hero-spotlight",
        "min_height": "78vh",
        "elements": {
          "hero_bg": "cover image with scale hover",
          "hero_overlay": "left + bottom + top vignette gradients",
          "hero_rank": "gold #1 Spotlight label",
          "hero_title": "clamp title",
          "hero_meta": "badge pills (HD, score, type)",
          "hero_actions": ["btn-watch gold pill", "btn-detail purple glass"],
          "hero_controls": "vertical prev/next arrows"
        }
      },

      "home_sections": {
        "continue_watching": { "id": "continueSection", "title_class": "section-title-gold" },
        "trending": {
          "id": "homeTrendingSection",
          "row": "trending-row horizontal scroll",
          "card": "150×220px poster with vertical title",
          "arrow": "trending-arrow scroll right"
        },
        "category_browse": {
          "id": "categorySection",
          "grid": "category-grid auto-fill minmax(160px, 1fr)"
        }
      },

      "watch_zone": {
        "id": "playerWrap",
        "class": "watch-zone glass-panel",
        "player_screen": {
          "aspect_ratio": "56.25% padding-top",
          "iframe_id": "playerIframe",
          "placeholder_id": "playerPlaceholder"
        },
        "toolbar": {
          "prev_next": ["prevEpBtn", "nextEpBtn"],
          "auto_next": "autoNext checkbox",
          "sub_dub": ["subBtn", "dubBtn"]
        },
        "server_panel": {
          "watching_msg": "watchingMsg",
          "sub_servers": "subServers",
          "dub_servers": "dubServers"
        }
      },

      "episodes_panel": {
        "class": "episodes-panel glass-panel",
        "toolbar": ["epLangFilter", "epRange", "epFind"],
        "list": "episode-list max-height 380px scroll",
        "row_active": "grad-brand background"
      },

      "detail_panel": {
        "class": "detail-panel glass-card",
        "grid": "180px poster | body | 200px rating card",
        "elements": ["seriesPoster", "seriesTitle", "bookmarkBtn", "seriesBadges", "seriesDesc", "metaGrid", "ratingCard", "franchiseSection"]
      },

      "sidebar_related": {
        "class": "sidebar-related glass-panel",
        "width": "var(--sidebar-w) 300px",
        "position": "sticky",
        "list_id": "recentList",
        "pagination": ["prevPage", "nextPage", "pageInfo"]
      },

      "mobile_bottom_nav": {
        "id": "mobileNav",
        "class": "mobile-bottom-nav",
        "items": ["Home", "Search", "Browse", "Library"],
        "display": "flex on mobile only"
      },

      "site_footer": {
        "class": "site-footer",
        "sections": {
          "az_list": { "id": "azGrid", "title": "A-Z List" },
          "footer_mid": { "brand": "AnimeXplore", "links": ["Help", "Request Anime", "DMCA", "Terms", "Contact", "Friends"] },
          "footer_legal": {
            "browser_tip": "Brave Browser recommendation",
            "copyright": "AnimeXplore",
            "disclaimer": "No files stored on server"
          }
        }
      },

      "buttons": {
        "btn_watch": {
          "class": "btn-watch",
          "background": "var(--gold-bright)",
          "color": "#111",
          "hover": "translateY(-2px) gold shadow"
        },
        "btn_detail": {
          "class": "btn-detail",
          "background": "rgba(88, 60, 120, 0.55)",
          "hover": "darker purple"
        },
        "tool_btn": {
          "class": "tool-btn",
          "active": "grad-brand gradient"
        },
        "server_btn": {
          "class": "server-btn",
          "active": "grad-brand gradient"
        }
      },

      "glass_surfaces": {
        "glass_panel": {
          "class": "glass-panel",
          "background": "var(--surface)",
          "backdrop_filter": "var(--blur)",
          "border": "1px solid var(--glass-border)",
          "border_radius": "var(--r-md)"
        },
        "glass_card": {
          "class": "glass-card",
          "border_radius": "var(--r-lg)",
          "floating_orbs": "disabled (display:none on ::before/::after)"
        }
      },

      "devtools_block": {
        "id": "dt-block",
        "z_index": 999999,
        "show_class": "show",
        "message": "Access Restricted — close Developer Tools"
      }
    },

    "animations": {
      "keyframes": {
        "fadeUp": { "from": "opacity 0 translateY(12px)", "to": "opacity 1 translateY(0)" },
        "viewIn": { "from": "opacity 0 translateY(14px)", "to": "opacity 1 translateY(0)" },
        "cardIn": { "from": "opacity 0 translateY(10px) scale(0.98)", "to": "opacity 1 scale(1)" },
        "spin": { "to": "rotate(360deg)" },
        "shimmer": { "usage": "brand gradient text optional" }
      },
      "view_transitions": {
        "view_enter": "viewIn var(--dur-slow)",
        "view_leave": "view-leaving opacity + translateY"
      },
      "card_stagger": "anime-card nth-child animation-delay 0.02s increments",
      "reduced_motion": "@media prefers-reduced-motion — disable animations"
    },

    "performance_modes": {
      "html_classes": {
        "perf-streaming": "disable backdrop-filter on glass surfaces and header"
      },
      "behaviors": {
        "streaming_blur_off": "solid rgba(18,16,25,0.94) replaces glass blur on panels"
      }
    },

    "interaction_patterns": {
      "page_titles": {
        "default": "AnimeXplore — Watch Anime Online Free in HD",
        "managed_by": "js/seo.js"
      },
      "search": {
        "dropdown": "searchDropdown",
        "api": "/api/search"
      },
      "streaming": {
        "embed_provider": "MegaPlay megaplay.buzz",
        "modes": ["embed_id sub/dub", "mal fallback", "ani fallback"]
      },
      "protection": {
        "devtools_block": true,
        "context_menu_block": true,
        "bot_guard": "headless/selenium/webdriver UA blocked"
      }
    },

    "responsive_rules": {
      "mobile_max_768": {
        "header_nav": "hidden or collapsed",
        "mobile_bottom_nav": "display flex",
        "hero_inner": "reduced padding",
        "detail_main": "single column stack",
        "sidebar_related": "hidden or below content",
        "server_panel": "single column grid"
      }
    },

    "reuse_guide": {
      "quick_start": [
        "1. Copy Design.json and js/design.js into project",
        "2. Link Inter from Google Fonts and css/style.css :root vars",
        "3. Call initDesign() on DOMContentLoaded to load palette",
        "4. applyAnimeXploreTheme() sets gold/blue runtime tokens",
        "5. Match HTML structure from index.html components section",
        "6. Recommend Brave Browser for streaming redirects (see user_notes)"
      ],
      "runtime_palette_mapping": {
        "primary_bg": "--bg",
        "glass_surface": "--surface, --surface-2",
        "highlight": "--highlight (overridden to gold at runtime)",
        "text_primary": "--text-1",
        "text_secondary": "--text-2"
      },
      "meta_tags": {
        "theme_color": "#050505",
        "site_name": "AnimeXplore",
        "description": "AnimeXplore — Watch Anime Online Free in HD"
      }
    }
  }
}
